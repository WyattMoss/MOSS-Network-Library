# Copy this file to env/.env and fill in your values.
# env/.env is gitignored so your token never gets committed.

# Base URL of your LibreNMS instance (no trailing slash, no /api/v0)
LIBRENMS_URL=https://librenms.example.com

# API token: LibreNMS UI -> Settings -> API -> Manage API Tokens
LIBRENMS_TOKEN=changeme

# Base URL of Fortigate 
FORTIGATE_URL=https://fortinet.com

# API token: FORTIGATE UI -> System -> Administrators -> Create New -? REST API Admin
FORTIGATE_TOKEN=changeme

# Set only if youre on a trusted internal network and hitting TLS errors
FORTIGATE_INSECURE_TLS=false

# How often the dashboard polls LibreNMS, in milliseconds
REFRESH_INTERVAL_MS=30000

# Port the container listens on internally (leave as-is unless you know why)
PORT=3000

# Port exposed on your host machine, e.g. http://localhost:8080
HOST_PORT=8080
