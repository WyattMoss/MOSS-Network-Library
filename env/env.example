# Copy this file to env/.env and fill in your values.
# env/.env is gitignored so your tokens never get committed.

# --- LibreNMS ---
LIBRENMS_URL=https://librenms.example.com
LIBRENMS_TOKEN=changeme
REFRESH_INTERVAL_MS=30000

# --- FortiGate ---
# Base URL, no trailing slash, e.g. https://192.168.1.1:443
FORTIGATE_URL=https://fortigate.example.com
# FortiGate GUI -> System -> Admin Profiles: create a REST API Admin, generate a token.
FORTIGATE_TOKEN=changeme
FORTIGATE_VDOM=root
# Only set true if your FortiGate uses a self-signed cert on a trusted network.
FORTIGATE_INSECURE_TLS=false

# --- WAN throughput graph ---
# How often to sample wan1/wan2 counters, in milliseconds.
WAN_POLL_INTERVAL_MS=30000
# How many hours of samples to keep in the SQLite file before pruning.
WAN_HISTORY_RETENTION_HOURS=3

# --- Ports ---
PORT=3000
HOST_PORT=8080
